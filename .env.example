# Steel Tide — production configuration.
# Copy to .env (never commit .env). None of these values is a secret, and none
# is sent to the browser except PUBLIC_URL, which is public by definition.

NODE_ENV=production

# Interface and port the Node process listens on. Behind a reverse proxy on the
# same machine use 127.0.0.1 so the port is not reachable from the internet;
# inside a container use 0.0.0.0 and publish the port only to the proxy.
HOST=127.0.0.1
PORT=3000

# The address players type, with scheme and no trailing slash. Used for invite
# links, for the WebSocket origin check and to enable HSTS when it is https.
PUBLIC_URL=https://play.example.com

# Extra origins allowed to open the game socket (comma separated). PUBLIC_URL is
# always allowed. Leave empty unless the page is also served from other hosts.
ALLOWED_ORIGINS=

# Set to 1 when a reverse proxy sits in front, so client addresses and the
# public host are read from X-Forwarded-For / X-Forwarded-Host. Leave 0 if the
# process is exposed directly, otherwise those headers could be spoofed.
TRUST_PROXY=1

# Capacity and abuse limits.
MAX_CLIENTS=1000
MAX_ROOMS=200
MAX_CONN_PER_IP=20

# How long a match waits for a dropped player before the room is closed.
RECONNECT_GRACE_MS=60000

# debug | info | warn | error
LOG_LEVEL=info
