<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for Steel Tide (TLS termination + WebSocket pass-through).

  Requires, on the server:
    - IIS with the "WebSocket Protocol" feature
    - URL Rewrite 2.1 and Application Request Routing 3.0 (Microsoft downloads)
    - ARR proxying enabled and the two HTTP_X_FORWARDED_* server variables allowed
  deploy\windows\setup-iis.ps1 does the last line and creates the site.

  The site folder contains only this file; everything is forwarded to the Node
  process on 127.0.0.1:3000 (setup-iis.ps1 rewrites the port if you changed it).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- The health check is for the machine itself, not the internet. -->
        <rule name="Steel Tide: hide health check" stopProcessing="true">
          <match url="^healthz$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <rule name="Steel Tide: redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Pages, scripts and the /ws WebSocket all go to the app. ARR upgrades
             the connection itself when the WebSocket Protocol feature is installed. -->
        <rule name="Steel Tide: reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- The app sends its own brotli/gzip bodies and cache headers: do not touch them. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="16384" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
